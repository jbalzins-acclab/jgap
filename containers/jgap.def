Bootstrap: docker
From: ubuntu:24.04

%labels
    Author "Jegors Balzins"
    Version "7.2.0"
    Description "JGAP: Gaussian Approximation Potentials in C++23 with Python & ASE"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates curl git

    # Add Toolchain PPA for GCC 15
    add-apt-repository -y ppa:ubuntu-toolchain-r/test
    apt-get update

    # Install compilers, build tools, libraries, and Python
    apt-get install -y --no-install-recommends \
        gcc-15 g++-15 cmake ninja-build \
        libhdf5-dev libopenblas-dev \
        python3 python3-dev python3-pip python3-venv

    # Setup default gcc/g++ alternatives to GCC 15
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-15 100
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-15 100

    # Install Python scientific stack & ASE
    pip install --no-cache-dir --break-system-packages \
        pybind11 numpy scipy ase pandas

%environment
    export CC=gcc-15
    export CXX=g++-15
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec "$@"

%help
    JGAP Apptainer/Singularity container with GCC 15 (C++23), HDF5, OpenBLAS, Python, and ASE.
    
    Interactive shell:
        apptainer shell jgap.sif
        
    Direct execution:
        apptainer exec jgap.sif cmake --preset release
        apptainer exec jgap.sif g++ -std=c++23 -O3 -march=native examples/basic_fit/BasicFit.cpp -ljgap -o basic_fit
        apptainer exec jgap.sif python3 examples/ase_integration/test_potential_with_ase.py pot.tabgap.h5 test.xyz
