{
    "name" : "jgap",
    "version" : "7.0.0",
    "dependencies" : [
        {
            "name": "tbb",
            "version>=": "2022.1.0#0"
        },
        {
            "name" : "eigen3",
            "version>=": "3.4.0#5"
        },
        {
            "name": "highfive",
            "version>=": "3.0.0"
        },
        {
            "name": "openblas",
            "version>=": "0.3.29#0",
            "features": ["threads"]
        }
    ],
    "features": {
        "xml": {
            "description": "QUIP XML conversion support (pugixml); enables QuipXmlConverter and the jgap_convert app",
            "dependencies": [
                {
                    "name": "pugixml",
                    "version>=": "1.15#0"
                }
            ]
        }
    },
    "default-features": ["xml"]
}
